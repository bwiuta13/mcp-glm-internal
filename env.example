# mcp-coding-glm — environment variables
#
# Copy this file's contents into the env section of the MCP server entry in
# ~/.codex/config.toml (or export them before launching), then fill in real values.
#
#   [mcp_servers.coding-glm]
#   env = { GREENNODE_API_KEY = "sk-..." }
#
# NOTE: the server itself never reads .env files. It forwards whatever it finds
# in its own environment down to the child `codex` processes, based on the
# `apiKeyEnv` name declared for each provider in ~/.mcp-coding-glm/config.json.

# API key for the coder model's provider (GreenNode, OpenAI-compatible endpoint).
# This is the name declared as apiKeyEnv in config.json -> providers.greennode.
GREENNODE_API_KEY=

# --- Test-only variables (not needed for normal use) -------------------------
# The test suite uses these to steer the fake binaries in test/fixtures/.
# FAKE_SCRIPT_DIR    — directory of scripted responses for scripted-codex.sh
# FAKE_HOLD_ON/FAKE_HOLD/FAKE_TOUCH/FAKE_LAST_MESSAGE/FAKE_EXIT/FAKE_SLEEP/
# FAKE_NO_WRITE/FAKE_BIG_UTF8/FAKE_GRANDCHILD_PIDFILE/FAKE_ESCAPED_NODE — fake-codex.sh knobs
# RECORD_TO          — argv/env recording target for record-exec.sh
# CODEX_BIN          — override the real codex binary path for the git-guard test
